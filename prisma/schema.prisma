// FamilyQuest — схема даних
// Сім'я, акаунти, разові й повторювані завдання, XP, коіни, журнал нарахувань.
// Статуси та причини нарахувань зберігаються рядками, а не enum-ами —
// так їх набір розширюється без міграції схеми (у Хвилі 2 так додався «Втрачене»).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Тривалість таймера зникнення простроченого завдання (Хвиля 2).
  overdueGraceMinutes Int     @default(60)
  // Чи бачать діти прогрес одне одного (Хвиля 2).
  showSiblingProgress Boolean @default(true)

  users       User[]
  tasks       Task[]
  templates   TaskTemplate[]
  ledger      LedgerEntry[]
  rewards     Reward[]
  redemptions RewardRedemption[]
}

// Шаблон повторюваного завдання. Сам по собі не є завданням:
// щодня з нього народжується окремий екземпляр Task, який і проходить
// звичайний цикл виконання та перевірки.
model TaskTemplate {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation("ChildTemplates", fields: [childId], references: [id], onDelete: Cascade)

  title       String
  description String?

  xpReward   Int
  coinReward Int @default(0)

  // Дні тижня у форматі Date.getDay(): "0" — неділя, "1" — понеділок…
  // Щоденне завдання зберігається як "0123456".
  weekdays String
  // Час дедлайну в межах дня, "HH:mm".
  dueTime  String

  // Дрібні щоденні звички не варті окремого підтвердження щоразу:
  // з цим прапорцем натискання дитини одразу зараховує винагороду.
  autoApprove Boolean @default(false)

  isPaused Boolean @default(false)

  // Дата останньої генерації, "YYYY-MM-DD" — захист від дублів
  // при кількох одночасних відкриттях застосунку.
  lastGeneratedOn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([familyId])
  @@index([childId, isPaused])
}

// Один акаунт на батьків (спільний для тата, мами, бабусі) + окремі акаунти дітей.
model User {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  role        String // "PARENT" | "CHILD"
  displayName String
  avatarColor String @default("violet")

  // IANA-зона пристрою, напр. "Europe/Kyiv". Визначає браузер і надсилає
  // при відкритті застосунку. Потрібна серверу там, де браузера поруч немає:
  // генерація повторюваних завдань і підрахунок серії.
  timeZone String @default("UTC")

  email    String? @unique // тільки батьки
  username String? @unique // тільки діти

  passwordHash String

  // Лічильники дитини. Джерело істини — LedgerEntry; це кеш для швидкого читання.
  xp               Int @default(0)
  coinsBalance     Int @default(0)
  coinsEarnedTotal Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  announcementReads AnnouncementRead[]
  assignedTasks     Task[]             @relation("ChildTasks")
  templates         TaskTemplate[]     @relation("ChildTemplates")
  redemptions       RewardRedemption[] @relation("ChildRedemptions")
  ledger            LedgerEntry[]

  @@index([familyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation("ChildTasks", fields: [childId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueAt       DateTime

  xpReward   Int
  coinReward Int @default(0)

  // ACTIVE | PENDING_REVIEW | DONE | REJECTED | OVERDUE | LOST
  status String @default("ACTIVE")

  childComment  String? // коментар дитини при поданні на перевірку
  parentComment String? // коментар батьків при відхиленні

  submittedAt DateTime?
  reviewedAt  DateTime?

  // Звідки взялося завдання. Порожньо — створене вручну.
  templateId     String?
  template       TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // День, за який згенеровано екземпляр, "YYYY-MM-DD".
  occurrenceDate String?

  // Копія прапорця шаблону на момент створення: зміна шаблону
  // не повинна змінювати правила для вже виданих завдань.
  autoApprove Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledger        LedgerEntry[]
  notifications Notification[]

  @@unique([templateId, occurrenceDate])
  @@index([familyId])
  @@index([childId, status])
}

// Журнал усіх нарахувань і списань. Зберігаємо події, а не лише підсумкові числа,
// щоб пізніше побудувати історію, досягнення, серії виконань і звіти.
model LedgerEntry {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation(fields: [childId], references: [id], onDelete: Cascade)

  kind   String // "XP" | "COIN"
  amount Int // додатне — нарахування, від'ємне — виплата
  reason String // "TASK_APPROVED" | "PAYOUT"

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())

  @@index([childId, kind])
  @@index([familyId, createdAt])
}

// Нагорода, яку батьки виставили в сімейному магазині.
// Ціна — у коінах, тих самих, що дитина заробляє за завдання.
model Reward {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  title       String
  description String?
  emoji       String  @default("🎁")

  costCoins Int

  // Нагороду можна прибрати з вітрини, не видаляючи: історія обмінів лишається цілою.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions RewardRedemption[]

  @@index([familyId, isActive])
}

// Обмін коінів на нагороду.
// Коіни списуються одразу при заявці — інакше дитина могла б «витратити»
// той самий баланс на кілька нагород, поки батьки не бачать. При відмові
// вони повертаються повністю.
model RewardRedemption {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId  String
  child    User   @relation("ChildRedemptions", fields: [childId], references: [id], onDelete: Cascade)

  rewardId String?
  reward   Reward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  // Знімок на момент обміну: зміна ціни чи назви не переписує минулі заявки.
  titleSnapshot String
  costSnapshot  Int
  emojiSnapshot String @default("🎁")

  // PENDING | FULFILLED | DECLINED
  status String @default("PENDING")

  childNote     String?
  parentComment String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([familyId, status])
  @@index([childId, status])
}

/// Персональне сповіщення. Один рядок — один адресат.
///
/// Новини про сам FamilyQuest сюди НЕ потраплять: для них буде окрема
/// модель з одним рядком на всіх і окремими позначками прочитання.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Тип рядком, як статуси завдань: новий тип не потребує міграції схеми.
  // Емодзі й категорію для нього дає lib/notifications/catalog.ts.
  type  String
  title String
  body  String
  /// Внутрішній маршрут, куди веде натискання. Порожньо — нікуди не веде.
  href  String?

  /// Завдання, якого стосується сповіщення. При видаленні завдання
  /// сповіщення лишається в історії, просто втрачає посилання.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// Ключ ідемпотентності, напр. "due-soon-60:<taskId>". Унікальний —
  /// саме він зробить повторний запуск фонового job'а безпечним, коли
  /// дійдемо до нагадувань за часом. Події, що трапляються один раз
  /// (створення завдання), ключа не потребують: NULL-ів може бути багато.
  dedupeKey String? @unique

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Новина про сам FamilyQuest: нова функція, виправлення, оновлення.
///
/// Один рядок — одна публікація, незалежно від кількості користувачів.
/// Персональні сповіщення для цього не підходять: новина для десяти тисяч
/// акаунтів створила б десять тисяч однакових рядків.
model Announcement {
  id String @id @default(cuid())

  // Рядками, як статуси завдань і типи сповіщень — новий різновид
  // не потребує міграції схеми.
  /// FEATURE | FIX | UPDATE | IMPORTANT
  category String
  /// ALL | PARENTS | CHILDREN. Згодом сюди ж ляжуть вужчі сегменти.
  audience String @default("ALL")

  title String
  body  String
  /// Куди веде натискання. Порожньо — новина просто позначається прочитаною.
  href  String?

  /// Порожньо — чернетка, її не бачить ніхто. Момент у майбутньому —
  /// відкладена публікація: новина з'явиться сама, коли він настане.
  publishedAt DateTime?

  /// Коли за цією новиною розіслали push. Порожньо — ще не розсилали.
  /// Найпростіший можливий захист від повторної розсилки: фоновий job
  /// бере лише новини без цієї позначки й ставить її одразу після
  /// відправлення. Окрема таблиця статусів доставки для цього зайва.
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  reads AnnouncementRead[]

  @@index([publishedAt])
}

/// Хто прочитав новину. Рядок з'являється лише в момент прочитання,
/// тому публікація не створює жодного запису на користувача.
model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([announcementId, userId])
  @@index([userId])
}

/// Push-підписка одного браузера на одному пристрої.
///
/// Один користувач має стільки підписок, скільки в нього пристроїв:
/// телефон, планшет, ноутбук. Тому «один користувач — одна підписка»
/// не закладено ніде.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Адреса, яку видав push-сервіс браузера. За специфікацією глобально
  /// унікальна — тому спільний планшет не доставлятиме чужі сповіщення:
  /// підписка просто перейде до того, хто зайшов останнім.
  endpoint String @unique
  /// Ключі шифрування payload. Без них push-сервіс не зможе передати
  /// вміст, а браузер — його прочитати.
  p256dh   String
  auth     String

  /// Допомагає людині впізнати свій пристрій у списку. Без точної моделі.
  userAgent String?

  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  /// Скільки разів поспіль відправлення не вдалося. Тимчасовий збій
  /// push-сервісу не повинен одразу видаляти підписку.
  failureCount  Int       @default(0)

  @@index([userId])
}
