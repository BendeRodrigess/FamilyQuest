# PostgreSQL. Локально рядок дає `npx prisma dev -n familyquest -d`,
# на сервері він лежить у /etc/familyquest/env і в репозиторій не потрапляє.
DATABASE_URL="postgres://postgres:postgres@localhost:ПОРТ/template1?sslmode=disable"

# Спільний секрет для фонового job'а нагадувань. Його знає лише
# systemd-таймер на сервері. Порожній або відсутній — job вимкнений
# і POST /api/jobs/reminders завжди відповідає 401.
JOB_SECRET="довгий-випадковий-рядок"
